    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "validatorClientSelector": {
          "type": "object"
        },
        "validatorClientNamespaceSelector": {
          "type": "object"
        },
        "monitoring": {
          "type": "object",
          "properties": {
            "enabled": {
