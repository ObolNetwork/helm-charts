  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "launchpad"
          }
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "properties": {
          "charon": {
            "required": [
              "operatorAddress"
            ],
            "properties": {
              "operatorAddress": {
