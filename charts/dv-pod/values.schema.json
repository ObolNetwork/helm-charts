{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "dv-pod values",
  "description": "Hand-written schema for the dv-pod chart. Do not regenerate with the helm schema plugin.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "network": {
      "type": "string",
      "enum": [
        "mainnet",
        "hoodi",
        "sepolia"
      ],
      "description": "Ethereum network; the chain id is derived from it."
    },
    "mode": {
      "type": "string",
      "enum": [
        "auto",
        "launchpad",
        "definition",
        "lock",
        "lockHash"
      ],
      "description": "How this node joins its cluster; see values.yaml."
    },
    "secrets": {
      "type": "object",
      "properties": {
        "defaultEnrPrivateKey": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "configMaps": {
      "type": "object",
      "properties": {
        "clusterLock": {
          "type": "string",
          "pattern": "^(|[a-z0-9]([-a-z0-9.]*[a-z0-9])?)$"
        }
      },
      "additionalProperties": false
    },
    "charon": {
      "type": "object",
      "properties": {
        "operatorAddress": {
          "type": "string",
          "pattern": "^(|0x[0-9a-fA-F]{40})$",
          "description": "Operator Ethereum address (0x + 40 hex). Required in mode launchpad."
        },
        "nickname": {
          "type": "string",
          "maxLength": 32
        },
        "beaconNodeEndpoints": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^https?://.+"
          },
          "minItems": 1
        },
        "fallbackBeaconNodeEndpoints": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^https?://.+"
          }
        },
        "publicnodeFallback": {
          "type": "boolean"
        },
        "beaconNodeHeaders": {
          "type": "string"
        },
        "beaconNodeHeadersSecretName": {
          "type": "string"
        },
        "beaconNodeHeadersSecretKey": {
          "type": "string"
        },
        "executionClientRpcEndpoint": {
          "type": "string",
          "pattern": "^(|https?://.+)$"
        },
        "builderApi": {
          "description": "Boolean. The strings \"true\"/\"false\" are accepted for backwards compatibility.",
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string",
              "enum": [
                "true",
                "false",
                ""
              ]
            }
          ]
        },
        "featureSet": {
          "type": "string",
          "enum": [
            "alpha",
            "beta",
            "stable"
          ]
        },
        "featureSetDisable": {
          "type": "string"
        },
        "featureSetEnable": {
          "type": "string"
        },
        "fetchFeeRecipientUpdates": {
          "type": "boolean"
        },
        "lockFile": {
          "type": "string"
        },
        "lockHash": {
          "type": "string",
          "pattern": "^(|0x[0-9a-fA-F]{64})$",
          "description": "Cluster lock hash (0x + 64 hex). Required in mode lockHash."
        },
        "logFormat": {
          "type": "string",
          "enum": [
            "console",
            "logfmt",
            "json"
          ]
        },
        "logLevel": {
          "type": "string",
          "enum": [
            "debug",
            "info",
            "warn",
            "error"
          ]
        },
        "lokiAddresses": {
          "type": "string"
        },
        "lokiService": {
          "type": "string"
        },
        "monitoringAddress": {
          "type": "string"
        },
        "noVerify": {
          "type": "boolean"
        },
        "p2pAllowlist": {
          "type": "string"
        },
        "p2pDenylist": {
          "type": "string"
        },
        "p2pDisableReuseport": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string",
              "enum": [
                "true",
                "false",
                ""
              ]
            }
          ]
        },
        "p2pExternalHostname": {
          "type": "string"
        },
        "p2pExternalIp": {
          "type": "string"
        },
        "p2pRelays": {
          "type": "string"
        },
        "p2pTcpAddress": {
          "type": "string"
        },
        "p2pUdpAddress": {
          "type": "string",
          "pattern": "^(|[^,]*:[0-9]+(,[^,]*:[0-9]+)*)$"
        },
        "validatorApiAddress": {
          "type": "string"
        },
        "directConnectionEnabled": {
          "description": "Boolean. The strings \"true\"/\"false\" are accepted for backwards compatibility.",
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string",
              "enum": [
                "true",
                "false",
                ""
              ]
            }
          ]
        },
        "privateKeyFile": {
          "type": "string"
        },
        "dkgSidecar": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "image": {
              "type": "object",
              "properties": {
                "repository": {
                  "type": "string"
                },
                "tag": {
                  "type": "string"
                },
                "pullPolicy": {
                  "type": "string",
                  "enum": [
                    "Always",
                    "IfNotPresent",
                    "Never"
                  ]
                }
              },
              "additionalProperties": false
            },
            "initialRetryDelaySeconds": {
              "type": "integer",
              "minimum": 1
            },
            "maxRetryDelaySeconds": {
              "type": "integer",
              "minimum": 1
            },
            "retryDelayFactor": {
              "type": "number",
              "minimum": 1
            },
            "retryDelaySeconds": {
              "type": "integer",
              "minimum": 1
            },
            "pageLimit": {
              "type": "integer",
              "minimum": 1
            },
            "apiEndpoint": {
              "type": "string",
              "pattern": "^https?://.+"
            },
            "targetConfigHash": {
              "type": "string",
              "pattern": "^(|0x[0-9a-fA-F]{64})$",
              "description": "Launchpad: join only this definition (0x + 64 hex)."
            },
            "resources": {
              "type": "object",
              "description": "Kubernetes resource requirements"
            },
            "serviceAccount": {
              "type": "object",
              "properties": {
                "create": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "enrJob": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "enr": {
          "type": "object",
          "properties": {
            "privateKey": {
              "type": "string",
              "pattern": "^(|(0x)?[0-9a-fA-F]{64})$",
              "description": "ENR private key hex (optional, prefer existingSecret)."
            },
            "existingSecret": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "privateKeyDataKey": {
                  "type": "string",
                  "minLength": 1
                },
                "publicKeyDataKey": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            },
            "generate": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "annotations": {
                  "type": "object"
                },
                "nodeSelector": {
                  "type": "object"
                },
                "kubectlImage": {
                  "type": "object",
                  "properties": {
                    "repository": {
                      "type": "string"
                    },
                    "tag": {
                      "type": "string"
                    },
                    "pullPolicy": {
                      "type": "string",
                      "enum": [
                        "Always",
                        "IfNotPresent",
                        "Never"
                      ]
                    }
                  },
                  "additionalProperties": false
                },
                "image": {
                  "description": "Deprecated and ignored (the ENR job uses `image`). Accepted so older values files still validate."
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "dkg": {
      "type": "object",
      "properties": {
        "runner": {
          "type": "string",
          "enum": [
            "charon",
            "sidecar"
          ]
        },
        "definition": {
          "type": "object",
          "properties": {
            "configHash": {
              "type": "string",
              "pattern": "^(|0x[0-9a-fA-F]{64})$",
              "description": "Published definition config hash (0x + 64 hex)."
            },
            "url": {
              "type": "string",
              "pattern": "^(|https://.+)$"
            },
            "configMap": {
              "type": "string"
            },
            "configMapKey": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "publish": {
          "type": "boolean"
        },
        "timeout": {
          "type": "string",
          "pattern": "^(|[0-9]+(\\.[0-9]+)?(ns|us|ms|s|m|h))+$"
        },
        "retryDelaySeconds": {
          "type": "integer",
          "minimum": 1
        },
        "extraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "resources": {
          "type": "object",
          "description": "Kubernetes resource requirements"
        },
        "status": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "statusReaders": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "namespace": {
            "type": "string",
            "minLength": 1
          },
          "serviceAccount": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "namespace",
          "serviceAccount"
        ],
        "additionalProperties": false
      },
      "description": "Service accounts granted get/watch on the dkg-status and enr ConfigMaps."
    },
    "validatorClient": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "type": {
          "type": "string",
          "enum": [
            "lighthouse",
            "teku",
            "prysm",
            "nimbus",
            "lodestar"
          ]
        },
        "image": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string"
            },
            "tag": {
              "type": "string"
            },
            "pullPolicy": {
              "type": "string",
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          },
          "additionalProperties": false
        },
        "config": {
          "type": "object",
          "properties": {
            "graffiti": {
              "type": "string"
            },
            "network": {
              "type": "string"
            },
            "extraArgs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "prysm": {
              "type": "object",
              "properties": {
                "extraArgs": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "resources": {
          "type": "object",
          "description": "Kubernetes resource requirements"
        },
        "keystores": {
          "type": "object",
          "properties": {
            "secretName": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "centralMonitoring": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "promEndpoint": {
          "type": "string",
          "pattern": "^https?://.+"
        },
        "token": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      },
      "additionalProperties": false
    },
    "imagePullSecrets": {
      "type": "array"
    },
    "global": {
      "type": "object",
      "description": "Shared values (e.g. from a parent chart)."
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "podAnnotations": {
      "type": "object"
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "annotations": {
          "type": "object"
        },
        "name": {
          "type": "string"
        },
        "nameTest": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "securityContext": {
      "type": "object",
      "description": "Pod securityContext"
    },
    "containerSecurityContext": {
      "type": "object",
      "description": "charon container securityContext"
    },
    "rbac": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "clusterRules": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "additionalProperties": false
    },
    "p2pService": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "type": {
          "type": "string",
          "enum": [
            "NodePort",
            "LoadBalancer"
          ]
        },
        "annotations": {
          "type": "object"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "nodePorts": {
          "type": "object",
          "properties": {
            "tcp": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 30000,
              "maximum": 32767
            },
            "udp": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 30000,
              "maximum": 32767
            }
          },
          "additionalProperties": false
        },
        "externalTrafficPolicy": {
          "type": "string",
          "enum": [
            "",
            "Cluster",
            "Local"
          ]
        },
        "loadBalancerIP": {
          "type": "string"
        },
        "loadBalancerSourceRanges": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "service": {
      "type": "object",
      "properties": {
        "clusterIP": {
          "type": "string"
        },
        "publishNotReadyAddresses": {
          "type": "boolean"
        },
        "ports": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "port": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              },
              "protocol": {
                "type": "string",
                "enum": [
                  "TCP",
                  "UDP"
                ]
              },
              "targetPort": {
                "type": [
                  "integer",
                  "string"
                ]
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "resources": {
      "type": "object",
      "description": "Kubernetes resource requirements"
    },
    "nodeSelector": {
      "type": "object"
    },
    "tolerations": {
      "type": [
        "array",
        "object"
      ],
      "description": "Pod tolerations (a list)."
    },
    "affinity": {
      "type": "object"
    },
    "priorityClassName": {
      "type": "string"
    },
    "podDisruptionBudget": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minAvailable": {
          "type": [
            "integer",
            "string"
          ]
        }
      },
      "additionalProperties": false
    },
    "clusterThreshold": {
      "type": [
        "integer",
        "string"
      ]
    },
    "updateStrategy": {
      "type": "string",
      "enum": [
        "RollingUpdate",
        "OnDelete"
      ]
    },
    "persistence": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "storageClassName": {
          "type": [
            "string",
            "null"
          ]
        },
        "accessModes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "ReadWriteOnce",
              "ReadWriteOncePod",
              "ReadWriteMany",
              "ReadOnlyMany"
            ]
          },
          "minItems": 1
        },
        "size": {
          "type": "string"
        },
        "validatorDataSize": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        },
        "retentionPolicy": {
          "type": "object",
          "properties": {
            "whenDeleted": {
              "type": "string",
              "enum": [
                "Retain",
                "Delete"
              ]
            },
            "whenScaled": {
              "type": "string",
              "enum": [
                "Retain",
                "Delete"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "serviceMonitor": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "path": {
          "type": "string"
        },
        "namespace": {
          "type": "string"
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Extra ServiceMonitor labels, e.g. release: monitoring"
        },
        "annotations": {
          "type": "object"
        },
        "interval": {
          "type": "string"
        },
        "scheme": {
          "type": "string",
          "enum": [
            "http",
            "https"
          ]
        },
        "tlsConfig": {
          "type": "object"
        },
        "scrapeTimeout": {
          "type": "string"
        },
        "relabelings": {
          "type": "array",
